# A qué API le habla el panel.
#
# En desarrollo va RELATIVO: con "/api" el navegador solo habla con el origen
# del panel (localhost:5180) y Vite reenvía al backend por dentro (ver `proxy`
# en vite.config.ts). Así no hay CORS y el navegador no necesita alcanzar un
# segundo puerto — cosa que algunos navegadores embebidos no pueden hacer.
VITE_API_URL="/api"

# En producción sí va la URL completa del backend, con su prefijo /api:
# VITE_API_URL="https://api.midominio.com/api"
